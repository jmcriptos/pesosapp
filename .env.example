# Variables de entorno para desarrollo local
# Copia este archivo como .env y ajusta los valores

# Autenticación
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=changeme

# Base de datos (desarrollo local)
DATABASE_URL=sqlite:///local.db

# Seguridad
SECRET_KEY=dev-unsafe-change-me

# Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Para Heroku, asegúrate de configurar estas variables:
# heroku config:set DEFAULT_USERNAME=tu_usuario
# heroku config:set DEFAULT_PASSWORD=tu_password_seguro
# heroku config:set SECRET_KEY=clave_secreta_segura

# Integración N8N / QuickBooks
# N8N_WEBHOOK_URL=https://n8n.example.com/webhook/xxx   # URL del webhook N8N para facturación
# N8N_WEBHOOK_TIMEOUT=30                                 # Timeout en segundos (default: 30)
# QB_SALES_SOURCE=auto                                   # auto | local | quickbooks
# N8N_QB_SALES_WEBHOOK_URL=https://n8n.example.com/webhook/qb-sales  # Endpoint N8N que devuelve ventas QuickBooks
# N8N_QB_SALES_TIMEOUT=20                                # Timeout en segundos para consulta de ventas
# DASHBOARD_USD_TO_XCG_FALLBACK_RATE=1.78               # Fallback cuando QBO/N8N retorna USD con tasa inválida (ej. 1)

# Consumo del plan de n8n (se cobra por ejecución).
# El refresco periódico del dashboard es el que más gasta: es el único que
# llama sin que nadie lo pida. Subir el intervalo y acotar la ventana es la
# palanca para bajar ejecuciones sin perder frescura útil.
# N8N_QB_REFRESH_INTERVAL_SEC=900   # Cada cuánto refresca el bucle (default: 900 = 15 min)
# N8N_QB_REFRESH_HORA_INICIO=6      # Hora local de Curaçao en que abre la ventana (default: 6)
# N8N_QB_REFRESH_HORA_FIN=19        # Hora local en que cierra (default: 19; igual a INICIO = 24 h)
# N8N_QB_REFRESH_DIAS=0-5           # Días con lunes=0 (default: 0-5 = lunes a sábado)
# QB_WARMUP_ON_BOOT=true            # Refresco al arrancar cada worker (default: true)

# Backup de Base de Datos
# HEROKU_APP_NAME=pesosapp     # Nombre de la app en Heroku (usado por scripts de backup)
# BACKUP_DIR=./backups          # Directorio local para backups exportados
