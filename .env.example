# Variables de entorno para desarrollo local
# Copia este archivo como .env y ajusta los valores

# Autenticación
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=changeme

# Base de datos (desarrollo local)
DATABASE_URL=sqlite:///local.db

# Seguridad
SECRET_KEY=dev-unsafe-change-me

# Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Para Heroku, asegúrate de configurar estas variables:
# heroku config:set DEFAULT_USERNAME=tu_usuario
# heroku config:set DEFAULT_PASSWORD=tu_password_seguro
# heroku config:set SECRET_KEY=clave_secreta_segura

# Integración N8N / QuickBooks
# N8N_WEBHOOK_URL=https://n8n.example.com/webhook/xxx   # URL del webhook N8N para facturación
# N8N_WEBHOOK_TIMEOUT=30                                 # Timeout en segundos (default: 30)
# QB_SALES_SOURCE=auto                                   # auto | local | quickbooks
# N8N_QB_SALES_WEBHOOK_URL=https://n8n.example.com/webhook/qb-sales  # Endpoint N8N que devuelve ventas QuickBooks
# N8N_QB_SALES_TIMEOUT=20                                # Timeout en segundos para consulta de ventas
# DASHBOARD_USD_TO_XCG_FALLBACK_RATE=1.78               # Fallback cuando QBO/N8N retorna USD con tasa inválida (ej. 1)

# Consumo del plan de n8n (se cobra por ejecución).
# El refresco automático de ventas viene APAGADO: corría cada 5 min las 24 h
# y agotó la cuota mensual. Las ejecuciones se reservan para la facturación,
# que es la que no puede fallar. El dashboard sigue trayendo ventas cuando
# alguien lo abre y la fila está vencida; si nunca hay fila, muestra
# «sin datos de QuickBooks» en vez de inventar una cifra.
# N8N_QB_REFRESH_INTERVAL_SEC=0     # 0 = bucle apagado (default). >0 lo enciende, en segundos
# QB_WARMUP_ON_BOOT=false           # Refresco al arrancar cada worker (default: false)
#
# Solo aplican si se vuelve a encender el bucle (INTERVAL > 0):
# N8N_QB_REFRESH_HORA_INICIO=6      # Hora local de Curaçao en que abre la ventana (default: 6)
# N8N_QB_REFRESH_HORA_FIN=19        # Hora local en que cierra (default: 19; igual a INICIO = 24 h)
# N8N_QB_REFRESH_DIAS=0-5           # Días con lunes=0 (default: 0-5 = lunes a sábado)
#
# Opción nuclear si hay que llegar a fin de mes con cero llamadas de ventas:
# QB_SALES_SOURCE=local             # El dashboard calcula ventas desde la BD de PesosApp

# Backup de Base de Datos
# HEROKU_APP_NAME=pesosapp     # Nombre de la app en Heroku (usado por scripts de backup)
# BACKUP_DIR=./backups          # Directorio local para backups exportados

# ── QuickBooks Online por API directa (sin n8n) ──────────────────────────
# Plan: docs/superpowers/plans/2026-09-11-qbo-api-directa.md
# Credenciales de la app en https://developer.intuit.com → Keys & credentials
# (pestaña Development para sandbox, Production para la empresa real).
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_ENVIRONMENT=sandbox           # sandbox | production
# QBO_REDIRECT_URI=http://localhost:5000/admin/quickbooks/callback   # igual a la registrada en Intuit
# QBO_MINOR_VERSION=75
# QBO_TIMEOUT=20                    # segundos por request
# QBO_TASA_USD=1.78                 # tasa USD→ANG que se fija en QBO (flask qbo-fijar-tasa)
# FACTURACION_BACKEND=n8n           # n8n (default) | qbo: quién crea y consulta facturas
# QB_SALES_BACKEND=n8n              # n8n (default) | qbo: de dónde salen las ventas del dashboard (Fase 2)

# ── Seguridad (2026-09-12) ───────────────────────────────────────────────
# QBO_TOKEN_KEY=                     # Clave Fernet: cifra los tokens de QuickBooks en la base.
#                                    # Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RATELIMIT_STORAGE_URI=memory://    # En Heroku, Redis para que el límite de login sobreviva
#                                    # reinicios y valga para todos los workers:
#                                    # rediss://...?ssl_cert_reqs=none (el REDIS_URL del add-on)
# TRUST_CF_CONNECTING_IP=0           # 1 solo si TODO el tráfico entra por Cloudflare
